// Prisma schema mirroring the Django `collegiates_app` database structure.
//
// Table names (@@map) and column names (@map) match Django's db_table /
// db_column so this schema maps onto a copy of the existing Postgres database.
// These choice fields are plain varchar(1) in Django (CharField with choices)
// and are modeled as proper Prisma enums whose members @map to the original DB
// codes so existing rows migrate over unchanged: gender / gender_category ->
// Gender, event_level -> SkillLevel, event_category -> EventCategory,
// skill_level -> SkillLevel, student_type -> StudentType, user_type -> UserType.
//
// Django framework tables (auth_*, django_*, token_blacklist_*) are intentionally
// omitted; only the application tables are modeled.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums. Each mirrors a Django CharField(choices) stored as a varchar code;
// every member @maps to the exact code persisted in the database, so existing
// rows migrate over unchanged. Prisma Client reads/writes the member NAMES, so
// the server boundary (lib/api.ts) translates member <-> code so the DTOs and
// forms keep speaking the original codes.
// ---------------------------------------------------------------------------

enum Gender {
  Male   @map("M")
  Female @map("F")

  @@map("gender")
}

enum SkillLevel {
  Beginner     @map("B")
  Intermediate @map("I")
  Advanced     @map("A")

  @@map("skill_level")
}

// Style classification for an event. Members @map to single-char codes to
// match the varchar(1) style of the other Event choice columns.
enum EventCategory {
  External @map("E")
  Internal @map("I")

  @@map("event_category")
}

enum StudentType {
  Undergraduate    @map("1") // Full/Part-Time Undergraduate Student
  FullTimeGraduate @map("2") // Full-Time Graduate/Professional School Student
  EarlyGraduate    @map("3") // Early Graduate Of Current Year
  NonEnrolled      @map("4") // Non-Enrolled Student
  OneYearAlumni    @map("5") // One Year Alumni
  PartTimeGraduate @map("6") // Part-Time Graduate Student
  International    @map("7") // International Student

  @@map("student_type")
}

// Account role. "C"/"O" are the legacy Django codes; "A" (Admin) is a new role
// with no legacy data.
enum UserType {
  Competitor @map("C")
  School     @map("O")
  Admin      @map("A")

  @@map("user_type")
}

// Weapon classification for an event. New field with no legacy data; members
// @map to single-char codes to match the varchar(1) style of the other Event
// choice columns.
enum WeaponType {
  Barehand @map("B")
  Short    @map("S")
  Long     @map("L")
  Other    @map("O")

  @@map("weapon_type")
}

model College {
  college_id   String @id @default(uuid()) @db.Uuid
  college_name String @unique @db.VarChar(255)

  competitor_profiles CompetitorProfile[]
  college_profiles    CollegeProfile[]
  groupsets           Groupset[]

  @@map("colleges")
}

model Event {
  event_code      String         @id @db.VarChar(50)
  event_name      String?        @unique @db.VarChar(255)
  event_level     SkillLevel?
  event_category  EventCategory?
  gender_category Gender?
  is_nandu        Boolean?
  weapon_type     WeaponType?

  registrations Registration[]
  event_orders  EventOrder[]

  @@map("events")
}

model User {
  // Django AbstractUser columns that exist on the real `users` table
  password     String    @db.VarChar(128)
  last_login   DateTime? @db.Timestamptz(6)
  is_superuser Boolean   @default(false)
  first_name   String    @default("") @db.VarChar(150)
  last_name    String    @default("") @db.VarChar(150)
  is_staff     Boolean   @default(false)
  is_active    Boolean   @default(true)
  date_joined  DateTime  @default(now()) @db.Timestamptz(6)

  // Custom fields
  user_id   String   @id @default(uuid()) @db.Uuid
  email     String   @unique @db.VarChar(254)
  user_type UserType @default(Competitor)

  // Competitor-specific attributes live on a one-to-one CompetitorProfile keyed
  // by this user's uuid (see CompetitorProfile). Competitors have no college
  // profile row, and organizers have no competitor one.
  competitor_profile CompetitorProfile?
  college_profile    CollegeProfile?
  // Competition settings this user hosts (see Settings.host).
  hosted_settings    Settings[]

  @@map("users")
}

// Competitor-specific attributes split out of `users` into a one-to-one table
// keyed by the user's uuid (the profile's PK *is* the user_id). A user has at
// most one profile; organizers typically have none.
model CompetitorProfile {
  user          User         @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  user_id       String       @id @db.Uuid
  gender        Gender?
  skill_level   SkillLevel?
  school        College?     @relation(fields: [school_id], references: [college_id], onDelete: SetNull)
  school_id     String?      @db.Uuid
  student_type  StudentType?
  is_competing  Boolean      @default(false)
  has_paid      Boolean      @default(false)
  proof_of_reg  Boolean      @default(false)
  // The reg_year (from Settings) the competitor last confirmed their profile
  // under. Not surfaced to the client; used server-side to force a returning
  // competitor back through /profile/setup when a new competition year starts.
  last_reg_year Int?

  registration      Registration[]
  groupset_member   GroupsetMember[]
  competitor_orders CompetitorOrder[]

  @@map("competitor_profile")
}

// Organizer-specific attributes split out of `users` into a one-to-one table
// keyed by the user's uuid (the profile's PK *is* the user_id), mirroring
// CompetitorProfile. A user has at most one college profile.
model CollegeProfile {
  user       User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  user_id    String   @id @db.Uuid
  college    College? @relation(fields: [college_id], references: [college_id], onDelete: SetNull)
  college_id String?  @db.Uuid
  // Competition years this organizer has hosted, as a set of ints (Postgres
  // integer[]). Empty by default.
  host_years Int[]    @default([])

  @@map("college_profile")
}

model Registration {
  id            BigInt            @id @default(autoincrement())
  competitor    CompetitorProfile @relation(fields: [competitor_id], references: [user_id], onDelete: Cascade)
  competitor_id String            @db.Uuid
  event         Event             @relation(fields: [event_code], references: [event_code], onDelete: Cascade)
  event_code    String            @db.VarChar(50)
  comp_year     Int
  date_created  DateTime          @default(now()) @db.Timestamptz(6)
  nandu_str     String?

  @@unique([competitor_id, comp_year, event_code])
  @@map("registration")
}

model Groupset {
  groupset_id  String   @id @default(uuid()) @db.Uuid
  comp_year    Int
  school       College  @relation(fields: [school_id], references: [college_id], onDelete: Cascade)
  school_id    String   @db.Uuid
  team_name    String   @db.VarChar(255)
  date_created DateTime @default(now()) @db.Timestamptz(6)

  members GroupsetMember[]

  @@map("groupset")
}

model GroupsetMember {
  id          String            @id @default(uuid()) @db.Uuid
  groupset    Groupset          @relation(fields: [groupset_id], references: [groupset_id], onDelete: Cascade)
  groupset_id String            @db.Uuid
  member      CompetitorProfile @relation(fields: [member_id], references: [user_id], onDelete: Cascade)
  member_id   String            @map("member") @db.Uuid
  date_joined DateTime          @default(now()) @db.Timestamptz(6)
  leader      Boolean

  @@unique([groupset_id, member_id])
  @@map("groupset_members")
}

model Blog {
  blog_id      String   @id @default(uuid()) @db.Uuid
  date_created DateTime @default(now()) @db.Timestamptz(6)
  author       String   @db.VarChar(255)
  category     String   @db.VarChar(255)
  title        String   @db.VarChar(255)
  blog_content String

  @@map("blog")
}

model Settings {
  id                   String    @id @default(uuid()) @db.Uuid
  reg_year             Int
  early_reg_start      DateTime? @db.Timestamptz(6)
  early_reg_cost_first Int?
  early_reg_cost_extra Int?
  reg_start            DateTime  @db.Timestamptz(6)
  reg_end              DateTime  @db.Timestamptz(6)
  reg_cost_first       Int
  reg_cost_extra       Int
  // Deadline for competitors to settle both outstanding requirements — payment
  // and proof of enrollment. Distinct from reg_end: registration can close
  // before the paperwork is due.
  due_date             DateTime? @db.Date
  comp_date            DateTime? @db.Date
  contact_email        String    @db.VarChar(254)
  // Whether the current year's event order is published (visible to competitors).
  // Lives on Settings rather than Order so publicity is part of event config.
  order_public         Boolean   @default(false)
  host                 User      @relation(fields: [host_id], references: [user_id], onDelete: Cascade)
  host_id              String    @db.Uuid
  created_at           DateTime  @default(now()) @db.Timestamptz(6)

  @@map("settings")
}

// A single scheduled slot in a ring: either an event (with an ordered list of
// competitors, via CompetitorOrder) or a break (event_id null, break_length set).
// Django field `event_id` is itself a ForeignKey, so its DB column is
// `event_id_id` (Django appends `_id` to the field name).
//
// A slot belongs directly to one Ring (`ring_id`) and holds its position within
// that ring in `order`. `ring_id` is nullable only so a slot can exist before it
// is assigned; every persisted slot is written with one.
model EventOrder {
  id           String  @id @db.Uuid
  comp_year    Int
  event        Event?  @relation(fields: [event_id], references: [event_code], onDelete: SetNull)
  event_id     String? @map("event_id_id") @db.VarChar(50)
  break_length Int
  name         String?
  order        Int     @default(0)
  ring         Ring?   @relation(fields: [ring_id], references: [id], onDelete: Cascade)
  ring_id      String? @db.Uuid

  competitor_orders CompetitorOrder[]

  @@index([ring_id])
  @@map("event_order")
}

// Through-model for EventOrder.competitor_list (Django ManyToManyField). No
// db_table on the Django model, so it keeps the default `collegiates_app_competitororder`.
model CompetitorOrder {
  id             BigInt            @id @default(autoincrement())
  order          Int               @default(0)
  event_order    EventOrder        @relation(fields: [event_order_id], references: [id], onDelete: Cascade)
  event_order_id String            @db.Uuid
  competitor     CompetitorProfile @relation(fields: [competitor_id], references: [user_id], onDelete: Cascade)
  competitor_id  String            @db.Uuid

  @@map("collegiates_app_competitororder")
}

// One saved order per competition year (comp_year is the primary key). Its rings
// are Ring rows — one per ring, so an Order has at most three.
model Order {
  comp_year  Int      @id
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  rings Ring[]

  @@map("order")
}

// One row per ring of an Order (ring_number 1/2/3), owning that ring's scheduled
// slots directly through EventOrder.ring_id. Replaces the former join table:
// there is exactly one Ring per (order, ring_number), and its EventOrders are
// sequenced by their own `order` field.
model Ring {
  id          String @id @default(uuid()) @db.Uuid
  ring_number Int
  order       Order  @relation(fields: [order_id], references: [comp_year], onDelete: Cascade)
  order_id    Int

  event_orders EventOrder[]

  @@unique([order_id, ring_number])
  @@map("ring")
}
