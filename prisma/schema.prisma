// Prisma schema mirroring the Django `collegiates_app` database structure.
//
// Table names (@@map) and column names (@map) match Django's db_table /
// db_column so this schema maps onto a copy of the existing Postgres database.
// Choice fields (gender, skill_level, user_type, etc.) are plain varchar(1) in
// Django (CharField with choices), so they are modeled as String here — not
// Prisma enums — to match the real column types.
//
// Django framework tables (auth_*, django_*, token_blacklist_*) are intentionally
// omitted; only the application tables are modeled.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model College {
  college_id   String @id @default(uuid()) @db.Uuid
  college_name String @unique @db.VarChar(255)

  competitor_profiles CompetitorProfile[]
  groupsets           Groupset[]
  settings            Settings[]

  @@map("colleges")
}

model Event {
  event_code      String   @id @db.VarChar(50)
  event_name      String?  @unique @db.VarChar(255)
  event_level     String?  @db.VarChar(1)
  event_category  String?  @db.VarChar(1)
  gender_category String?  @db.VarChar(1)
  is_nandu        Boolean?

  registrations Registration[]
  event_orders  EventOrder[]

  @@map("events")
}

model User {
  // Django AbstractUser columns that exist on the real `users` table
  password     String    @db.VarChar(128)
  last_login   DateTime? @db.Timestamptz(6)
  is_superuser Boolean   @default(false)
  first_name   String    @default("") @db.VarChar(150)
  last_name    String    @default("") @db.VarChar(150)
  is_staff     Boolean   @default(false)
  is_active    Boolean   @default(true)
  date_joined  DateTime  @default(now()) @db.Timestamptz(6)

  // Custom fields
  user_id      String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.VarChar(254)
  user_type    String    @default("C") @db.VarChar(1)

  // Competitor-specific attributes live on a one-to-one CompetitorProfile keyed
  // by this user's uuid (see CompetitorProfile). Organizers have no profile row.
  competitor_profile CompetitorProfile?

  registration      Registration[]
  groupset_member   GroupsetMember[]
  competitor_orders CompetitorOrder[]
  tokens            VerificationToken[]

  @@map("users")
}

// Competitor-specific attributes split out of `users` into a one-to-one table
// keyed by the user's uuid (the profile's PK *is* the user_id). A user has at
// most one profile; organizers typically have none.
model CompetitorProfile {
  user         User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  user_id      String   @id @db.Uuid
  gender       String?  @db.VarChar(1)
  school       College? @relation(fields: [school_id], references: [college_id], onDelete: SetNull)
  school_id    String?  @db.Uuid
  student_type String?  @db.VarChar(1)
  skill_level  String?  @db.VarChar(1)
  is_competing Boolean  @default(false)
  has_paid     Boolean  @default(false)
  proof_of_reg Boolean  @default(false)
  // The reg_year (from Settings) the competitor last confirmed their profile
  // under. Not surfaced to the client; used server-side to force a returning
  // competitor back through /profile/setup when a new competition year starts.
  last_reg_year Int?

  @@map("competitor_profile")
}

// Single-use tokens for account activation ("A") and password reset ("P").
// Only the sha256 hash of the token is stored — the raw value lives solely in
// the emailed link, mirroring how passwords are never stored in the clear.
model VerificationToken {
  id         String    @id @default(uuid()) @db.Uuid
  user       User      @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  user_id    String    @db.Uuid
  token_hash String    @unique @db.VarChar(64)
  purpose    String    @db.VarChar(1)
  expires_at DateTime  @db.Timestamptz(6)
  used_at    DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)

  @@index([user_id, purpose])
  @@map("verification_tokens")
}

model Registration {
  id           BigInt   @id @default(autoincrement())
  competitor   User     @relation(fields: [competitor_id], references: [user_id], onDelete: Cascade)
  competitor_id String  @db.Uuid
  event        Event    @relation(fields: [event_code], references: [event_code], onDelete: Cascade)
  event_code   String   @db.VarChar(50)
  comp_year    Int
  date_created DateTime @default(now()) @db.Timestamptz(6)
  nandu_str    String?

  @@unique([competitor_id, comp_year, event_code])
  @@map("registration")
}

model Groupset {
  groupset_id  String   @id @default(uuid()) @db.Uuid
  comp_year    Int
  school       College  @relation(fields: [school_id], references: [college_id], onDelete: Cascade)
  school_id    String   @db.Uuid
  team_name    String   @db.VarChar(255)
  date_created DateTime @default(now()) @db.Timestamptz(6)

  members GroupsetMember[]

  @@map("groupset")
}

model GroupsetMember {
  id          String   @id @default(uuid()) @db.Uuid
  groupset    Groupset @relation(fields: [groupset_id], references: [groupset_id], onDelete: Cascade)
  groupset_id String   @db.Uuid
  member      User     @relation(fields: [member_id], references: [user_id], onDelete: Cascade)
  member_id   String   @map("member") @db.Uuid
  date_joined DateTime @default(now()) @db.Timestamptz(6)
  leader      Boolean

  @@unique([groupset_id, member_id])
  @@map("groupset_members")
}

model Blog {
  blog_id      String   @id @default(uuid()) @db.Uuid
  date_created DateTime @default(now()) @db.Timestamptz(6)
  author       String   @db.VarChar(255)
  category     String   @db.VarChar(255)
  title        String   @db.VarChar(255)
  blog_content String

  @@map("blog")
}

model Settings {
  id                   String    @id @default(uuid()) @db.Uuid
  reg_year             Int
  early_reg_start      DateTime? @db.Timestamptz(6)
  early_reg_cost_first Int?
  early_reg_cost_extra Int?
  reg_start            DateTime  @db.Timestamptz(6)
  reg_end              DateTime  @db.Timestamptz(6)
  reg_cost_first       Int
  reg_cost_extra       Int
  comp_date            DateTime? @db.Date
  contact_email        String    @db.VarChar(254)
  // Whether the current year's event order is published (visible to competitors).
  // Lives on Settings rather than Order so publicity is part of event config.
  order_public         Boolean   @default(false)
  host                 College   @relation(fields: [school_id], references: [college_id], onDelete: Cascade)
  school_id            String    @db.Uuid
  created_at           DateTime  @default(now()) @db.Timestamptz(6)

  @@map("settings")
}

// A single scheduled slot in a ring: either an event (with an ordered list of
// competitors, via CompetitorOrder) or a break (event_id null, break_length set).
// Django field `event_id` is itself a ForeignKey, so its DB column is
// `event_id_id` (Django appends `_id` to the field name).
model EventOrder {
  id           String  @id @db.Uuid
  comp_year    Int
  event        Event?  @relation(fields: [event_id], references: [event_code], onDelete: SetNull)
  event_id     String? @map("event_id_id") @db.VarChar(50)
  break_length Int
  name         String?
  order        Int     @default(0)

  competitor_orders CompetitorOrder[]
  ring1             OrderRing1[]
  ring2             OrderRing2[]
  ring3             OrderRing3[]

  @@map("event_order")
}

// Through-model for EventOrder.competitor_list (Django ManyToManyField). No
// db_table on the Django model, so it keeps the default `collegiates_app_competitororder`.
model CompetitorOrder {
  id             BigInt     @id @default(autoincrement())
  order          Int        @default(0)
  event_order    EventOrder @relation(fields: [event_order_id], references: [id], onDelete: Cascade)
  event_order_id String     @db.Uuid
  competitor     User       @relation(fields: [competitor_id], references: [user_id], onDelete: Cascade)
  competitor_id  String     @db.Uuid

  @@map("collegiates_app_competitororder")
}

// One saved order per competition year (comp_year is the primary key). The three
// rings are Django ManyToManyFields to EventOrder, each backed by an implicit
// join table (`order_ring1/2/3`) modeled explicitly below.
model Order {
  comp_year  Int      @id
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  ring1 OrderRing1[]
  ring2 OrderRing2[]
  ring3 OrderRing3[]

  @@map("order")
}

// Implicit M2M join tables for Order.ring1/ring2/ring3. Django names the columns
// after the lowercased model names (`order_id`, `eventorder_id`); `order_id`
// references Order's PK, which is `comp_year`.
model OrderRing1 {
  id            BigInt     @id @default(autoincrement())
  order         Order      @relation(fields: [order_id], references: [comp_year], onDelete: Cascade)
  order_id      Int
  eventorder    EventOrder @relation(fields: [eventorder_id], references: [id], onDelete: Cascade)
  eventorder_id String     @db.Uuid

  @@unique([order_id, eventorder_id])
  @@map("order_ring1")
}

model OrderRing2 {
  id            BigInt     @id @default(autoincrement())
  order         Order      @relation(fields: [order_id], references: [comp_year], onDelete: Cascade)
  order_id      Int
  eventorder    EventOrder @relation(fields: [eventorder_id], references: [id], onDelete: Cascade)
  eventorder_id String     @db.Uuid

  @@unique([order_id, eventorder_id])
  @@map("order_ring2")
}

model OrderRing3 {
  id            BigInt     @id @default(autoincrement())
  order         Order      @relation(fields: [order_id], references: [comp_year], onDelete: Cascade)
  order_id      Int
  eventorder    EventOrder @relation(fields: [eventorder_id], references: [id], onDelete: Cascade)
  eventorder_id String     @db.Uuid

  @@unique([order_id, eventorder_id])
  @@map("order_ring3")
}
