// Prisma schema mirroring the Django `collegiates_app` database: @@map/@map match db_table and
// db_column, and enum members @map to the stored codes. Django framework tables are omitted.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Each enum mirrors a Django CharField(choices). Prisma Client reads and writes member NAMES, so
// lib/api.ts translates member <-> code at the boundary, keeping DTOs and forms on the codes.

enum Gender {
  Male   @map("M")
  Female @map("F")

  @@map("gender")
}

enum SkillLevel {
  Beginner     @map("B")
  Intermediate @map("I")
  Advanced     @map("A")

  @@map("skill_level")
}

// External/Internal are the legacy Django split; Groupset is its own category because the team
// event is neither, and it is entered through a groupset rather than individual registration.
enum EventCategory {
  External @map("E")
  Internal @map("I")
  Groupset @map("G")

  @@map("event_category")
}

// Competitors self-report the eligibility class from rules I directly, rather
// than a finer-grained school status the app would have to classify.
enum StudentType {
  ClassOne @map("1") // Class 1
  ClassTwo @map("2") // Class 2

  @@map("student_type")
}

// "C"/"O" are the legacy Django codes; "A" (Admin) is a new role with no legacy
// data.
enum UserType {
  Competitor @map("C")
  School     @map("O")
  Admin      @map("A")

  @@map("user_type")
}

// Why a verification token was issued. No legacy data — the codes were already
// what the column stored, and stay single-char to match the other enums.
enum TokenPurpose {
  Activation    @map("A")
  PasswordReset @map("P")
  // A school account created by an admin: the link sets its first password and
  // activates it in one step, so it is neither of the two above.
  SchoolInvite  @map("S")

  @@map("token_purpose")
}

// New field with no legacy data; single-char codes match the other Event choice
// columns.
enum WeaponType {
  Barehand @map("B")
  Short    @map("S")
  Long     @map("L")
  Other    @map("O")

  @@map("weapon_type")
}

model College {
  college_id   String @id @default(uuid()) @db.Uuid
  college_name String @unique @db.VarChar(255)

  competitor_profiles CompetitorProfile[]
  college_profiles    CollegeProfile[]
  groupsets           Groupset[]

  @@map("colleges")
}

model Event {
  event_code      String         @id @db.VarChar(50)
  event_name      String?        @unique @db.VarChar(255)
  event_level     SkillLevel?
  event_category  EventCategory?
  gender_category Gender?
  is_nandu        Boolean?
  // Marks the Changquan and Nanquan disciplines, nandu variants included — the External
  // All-Around's first requirement (rules 4.I). Nothing else identifies them; new field, nullable.
  is_cq_nq        Boolean?
  weapon_type     WeaponType?

  registrations Registration[]
  event_orders  EventOrder[]

  @@map("events")
}

model User {
  // Django AbstractUser columns, then this app's own. is_active gates login in
  // auth.ts; role attributes live in the one-to-one profiles below.
  password    String   @db.VarChar(128)
  first_name  String   @default("") @db.VarChar(150)
  last_name   String   @default("") @db.VarChar(150)
  is_active   Boolean  @default(true)
  date_joined DateTime @default(now()) @db.Timestamptz(6)

  user_id       String   @id @default(uuid()) @db.Uuid
  email         String   @unique @db.VarChar(254)
  user_type     UserType @default(Competitor)
  // Bumped on every password change. getCurrentUser() compares it against the
  // session token's copy, revoking stale sessions without a session table.
  token_version Int      @default(0)

  competitor_profile CompetitorProfile?
  college_profile    CollegeProfile?
  hosted_settings    Settings[]
  tokens             VerificationToken[]

  @@map("users")
}

// Competitor attributes split out of `users`; the profile's PK *is* the user_id.
model CompetitorProfile {
  user          User         @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  user_id       String       @id @db.Uuid
  gender        Gender?
  skill_level   SkillLevel?
  school        College?     @relation(fields: [school_id], references: [college_id], onDelete: SetNull)
  school_id     String?      @db.Uuid
  student_type  StudentType?
  is_competing  Boolean      @default(false)
  // Whole dollars received so far, checked against the fee lib/fees.ts computes.
  // 0 is "nothing paid"; a part payment is recorded as the amount that arrived.
  amt_paid      Int          @default(0)
  proof_of_reg  Boolean      @default(false)
  // Last Settings.reg_year confirmed under; re-runs /competitor/profile on a new year.
  last_reg_year Int?

  registration      Registration[]
  groupset_member   GroupsetMember[]
  competitor_orders CompetitorOrder[]

  @@map("competitor_profile")
}

// Organizer counterpart to CompetitorProfile; the profile's PK *is* the user_id.
model CollegeProfile {
  user       User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  user_id    String   @id @db.Uuid
  college    College? @relation(fields: [college_id], references: [college_id], onDelete: SetNull)
  college_id String?  @db.Uuid
  // Competition years hosted (Postgres integer[]), empty by default.
  host_years Int[]    @default([])

  @@map("college_profile")
}

// Single-use tokens for account activation, password reset, and a school
// account's invitation — see TokenPurpose. Only the sha256 hash is stored; the
// raw value lives solely in the emailed link.
model VerificationToken {
  id         String       @id @default(uuid()) @db.Uuid
  user       User         @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  user_id    String       @db.Uuid
  token_hash String       @unique @db.VarChar(64)
  purpose    TokenPurpose
  expires_at DateTime     @db.Timestamptz(6)
  used_at    DateTime?    @db.Timestamptz(6)
  created_at DateTime     @default(now()) @db.Timestamptz(6)

  @@index([user_id, purpose])
  @@map("verification_tokens")
}

model Registration {
  id            BigInt            @id @default(autoincrement())
  competitor    CompetitorProfile @relation(fields: [competitor_id], references: [user_id], onDelete: Cascade)
  competitor_id String            @db.Uuid
  event         Event             @relation(fields: [event_code], references: [event_code], onDelete: Cascade)
  event_code    String            @db.VarChar(50)
  comp_year     Int
  date_created  DateTime          @default(now()) @db.Timestamptz(6)
  nandu_str     String?

  @@unique([competitor_id, comp_year, event_code])
  @@map("registration")
}

model Groupset {
  groupset_id  String   @id @default(uuid()) @db.Uuid
  comp_year    Int
  school       College  @relation(fields: [school_id], references: [college_id], onDelete: Cascade)
  school_id    String   @db.Uuid
  team_name    String   @db.VarChar(255)
  date_created DateTime @default(now()) @db.Timestamptz(6)

  members GroupsetMember[]

  @@map("groupset")
}

model GroupsetMember {
  id          String            @id @default(uuid()) @db.Uuid
  groupset    Groupset          @relation(fields: [groupset_id], references: [groupset_id], onDelete: Cascade)
  groupset_id String            @db.Uuid
  member      CompetitorProfile @relation(fields: [member_id], references: [user_id], onDelete: Cascade)
  member_id   String            @map("member") @db.Uuid
  date_joined DateTime          @default(now()) @db.Timestamptz(6)
  leader      Boolean

  @@unique([groupset_id, member_id])
  @@map("groupset_members")
}

model Blog {
  blog_id      String   @id @default(uuid()) @db.Uuid
  date_created DateTime @default(now()) @db.Timestamptz(6)
  author       String   @db.VarChar(255)
  category     String   @db.VarChar(255)
  title        String   @db.VarChar(255)
  blog_content String

  @@map("blog")
}

model Settings {
  id                   String    @id @default(uuid()) @db.Uuid
  reg_year             Int
  early_reg_start      DateTime? @db.Timestamptz(6)
  // Flat fee charged once per competitor, plus a per-event fee on top of it.
  early_reg_cost_base  Int?
  early_reg_cost_event Int?
  reg_start            DateTime  @db.Timestamptz(6)
  reg_end              DateTime  @db.Timestamptz(6)
  reg_cost_base        Int
  reg_cost_event       Int
  // Deadline for payment + proof of enrollment; separate from reg_end.
  due_date             DateTime? @db.Date
  comp_date            DateTime? @db.Date
  contact_email        String    @db.VarChar(254)
  // Where live scores are published for this competition; blank until there is one.
  scoring_url          String?   @db.VarChar(500)
  // Whether this year's event order is visible to competitors.
  order_public         Boolean   @default(false)
  // The event order used to be its own per-year `order` table; its rings now hang off the year's
  // Settings row. Null until an order has first been saved, which reads as "no order yet".
  order_updated_at     DateTime? @db.Timestamptz(6)
  host                 User      @relation(fields: [host_id], references: [user_id], onDelete: Cascade)
  host_id              String    @db.Uuid
  created_at           DateTime  @default(now()) @db.Timestamptz(6)

  rings Ring[]

  @@map("settings")
}

// One scheduled slot in a ring: an event with ordered competitors, or a break.
model EventOrder {
  id           String  @id @db.Uuid
  comp_year    Int
  event        Event?  @relation(fields: [event_id], references: [event_code], onDelete: SetNull)
  event_id     String? @map("event_id_id") @db.VarChar(50)
  break_length Int
  name         String?
  order        Int     @default(0)
  ring         Ring?   @relation(fields: [ring_id], references: [id], onDelete: Cascade)
  // Nullable only so a slot can exist before assignment; persisted slots have one.
  ring_id      String? @db.Uuid

  competitor_orders CompetitorOrder[]

  @@index([ring_id])
  @@map("event_order")
}

// Through-model for EventOrder's competitor list; keeps Django's default table name.
model CompetitorOrder {
  id             BigInt            @id @default(autoincrement())
  order          Int               @default(0)
  event_order    EventOrder        @relation(fields: [event_order_id], references: [id], onDelete: Cascade)
  event_order_id String            @db.Uuid
  competitor     CompetitorProfile @relation(fields: [competitor_id], references: [user_id], onDelete: Cascade)
  competitor_id  String            @db.Uuid

  @@map("collegiates_app_competitororder")
}

// One ring (ring_number 1/2/3) of a year's saved order, owning its slots via EventOrder.ring_id and
// sequencing them by EventOrder.order. Hangs off Settings: the order is per competition year.
model Ring {
  id          String   @id @default(uuid()) @db.Uuid
  ring_number Int
  settings    Settings @relation(fields: [settings_id], references: [id], onDelete: Cascade)
  settings_id String   @db.Uuid

  event_orders EventOrder[]

  @@unique([settings_id, ring_number])
  @@map("ring")
}
